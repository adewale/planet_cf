// wrangler.jsonc (Wrangler v4.58.0+, January 2026)
// Planet CF - Feed Aggregator for Cloudflare Python Workers
//
// =============================================================================
// MODE CONFIGURATION
// =============================================================================
// This config runs in FULL mode with all features enabled.
//
// To ENABLE lite mode (disable search and admin):
//   1. Add "INSTANCE_MODE": "lite" to vars section
//   2. Remove the entire "vectorize" section
//   3. Remove the entire "ai" section
//   4. No OAuth secrets are required in lite mode
//
// Lite mode disables:
//   - Semantic search functionality
//   - Admin interface and OAuth login
//   - Embedding generation
// NOTE (re-audit H12/M8): this "full-featured" example previously shared the
// worker name `test-planet`, the `test-planet-*` resource names, AND the test
// instance's database_id with the root config and examples/test-planet. Deploying
// it therefore overwrote the live E2E test worker (and inherited its secret).
// It now uses its own clearly-placeholder names/ids. Replace these placeholders
// with your real resources before deploying (or use create_instance.py). Do NOT
// point this at production (planetcf / www.planetcloudflare.dev).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planet-cloudflare-example",
  "main": "../../src/main.py",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["python_workers", "python_dedicated_snapshot"],

  // CPU time limit - increase from 30s default for feed parsing
  "limits": {
    "cpu_ms": 60000
  },

  // Environment variables
  "vars": {
    "PLANET_NAME": "Planet Cloudflare",
    "PLANET_DESCRIPTION": "Aggregated posts from the Cloudflare-adjacent community",
    "PLANET_URL": "https://planet-cloudflare-example.example.workers.dev",
    "PLANET_OWNER_NAME": "Cloudflare",
    "RETENTION_DAYS": "90",
    "RETENTION_MAX_ENTRIES_PER_FEED": "100",
    "FEED_TIMEOUT_SECONDS": "60",
    "HTTP_TIMEOUT_SECONDS": "30",
    // Observability context
    "THEME": "planet-cloudflare",
    "DEPLOYMENT_ENVIRONMENT": "test"
    // DEPLOYMENT_VERSION is set dynamically via VERSION_METADATA binding below
    // Search configuration (optional - uses defaults if not set):
    // "EMBEDDING_MAX_CHARS": "2000",       // Max chars to embed per entry
    // "SEARCH_SCORE_THRESHOLD": "0.3",     // Min cosine similarity (0.0-1.0)
    // "SEARCH_TOP_K": "50"                 // Max semantic results before filtering
  },

  // Secrets (set via wrangler secret put):
  // - GITHUB_CLIENT_ID: OAuth client ID
  // - GITHUB_CLIENT_SECRET: OAuth client secret
  // - SESSION_SECRET: HMAC key for signed cookies (generate with: openssl rand -hex 32)
  // - OAUTH_REDIRECT_URI: Full OAuth callback URL for production (e.g., https://www.planetcloudflare.dev/auth/github/callback)
  //   This is a security best practice to prevent open redirect attacks. If not set, falls back to request origin.

  // Workers Observability
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },

  // D1 Database
  // Use remote: true in dev to access production data (create preview_database_id for safer dev)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "planet-cloudflare-example-db",
      // PLACEHOLDER — replace with the id printed by `wrangler d1 create`.
      // (Never reuse the production or test-planet database_id here.)
      "database_id": "YOUR_DATABASE_ID",
      "remote": true
    }
  ],

  // No KV needed:
  // - HTML/RSS/Atom/OPML: Generated on-demand, cached at edge via Cache-Control
  // - Sessions: Stateless signed cookies (HMAC), no server-side storage

  // Vectorize (for semantic search)
  "vectorize": [
    {
      "binding": "SEARCH_INDEX",
      "index_name": "planet-cloudflare-example-entries",
      "remote": true
    }
  ],

  // Workers AI (for generating embeddings)
  "ai": {
    "binding": "AI",
    "remote": true
  },

  // Version metadata (for observability)
  "version_metadata": {
    "binding": "VERSION_METADATA"
  },

  // Queues: Scheduler -> Fetcher
  "queues": {
    "producers": [
      { "binding": "FEED_QUEUE", "queue": "planet-cloudflare-example-feed-queue" },
      { "binding": "DEAD_LETTER_QUEUE", "queue": "planet-cloudflare-example-feed-dlq" }
    ],
    "consumers": [
      {
        "queue": "planet-cloudflare-example-feed-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "planet-cloudflare-example-feed-dlq",
        "retry_delay": 300
      },
      // M-D5: consume the DLQ too. Without a consumer, dead-lettered messages
      // accumulate for ~4 days and silently vanish. The src queue handler treats
      // any queue whose name contains "dlq" as the dead-letter handler.
      {
        "queue": "planet-cloudflare-example-feed-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 60
      }
    ]
  },

  // Static assets served via Cloudflare's ASSETS binding
  "assets": {
    "directory": "./assets/",
    "binding": "ASSETS"
  },

  // Cron trigger: Hourly feed fetch (content generated on-demand)
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
